{
  "name": "hover-glossary",
  "version": "1.2.0",
  "description": "Клиентский плагин DSH: наведите курсор на слово в тексте диалога — всплывающая подсказка покажет 1..N толкований",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "plugin",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "DEVELOPMENT.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node test/run.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bondiano/hover-glossary.git"
  },
  "homepage": "https://github.com/bondiano/hover-glossary#readme",
  "bugs": {
    "url": "https://github.com/bondiano/hover-glossary/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "hover-glossary",
    "russian"
  ]
}
