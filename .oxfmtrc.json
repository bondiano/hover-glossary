{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"endOfLine": "lf",
	"sortImports": false,
	"sortPackageJson": false,
	"ignorePatterns": ["node_modules/**", "dist/**", "package-lock.json"]
}
