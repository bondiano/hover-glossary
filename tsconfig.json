{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": ".",
		"types": ["node"],
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "legacy",
		"noEmitOnError": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"]
	},
	"include": ["*.ts", "types/**/*.ts", "test/**/*.ts"]
}
